}
globals = {
	-- the add-on's own sanctioned globals
	"ConnoisseurDB",
	"ConnoisseurRestockerDB",
	"ConnoisseurState",
	"ConnFire",
	"ConnTip",
	"ConnIf",
	"ConnNoItem",
	"CRS_ADDON",
	"CrsModule",
	"CrsKvModuleManager",
	"SLASH_CONNOISSEUR1",
	"SLASH_CONNOISSEURRESTOCKER1",
	"SlashCmdList",
