	"ERR_ITEM_WRONG_ZONE",
	"EditMacro",
	"GameTooltip",
	"GetBuildInfo",
	"GetCVar",
	"GetContainerNumSlots",
	"GetInventorySlotInfo",
	"GetItemCount",
	"GetItemFamily",
	"GetItemIcon",
	"GetItemInfo",
	"GetItemQualityColor",
	"GetLocale",
	"GetMacroBody",
	"GetMacroIndexByName",
	"GetMerchantItemInfo",
	"GetMerchantItemLink",
	"GetMerchantNumItems",
	"GetNetStats",
	"GetNumGroupMembers",
	"GetNumMacros",
	"GetNumQuestLogEntries",
	"GetNumSkillLines",
	"GetPetFoodTypes",
	"GetPhysicalScreenSize",
	"GetQuestLogTitle",
	"GetSkillLineInfo",
	"GetSpellInfo",
	"GetSubZoneText",
	"GetTime",
	"GetZoneText",
	"InCombatLockdown",
	"IsInGroup",
	"IsInInstance",
	"IsInRaid",
	"IsPlayerSpell",
	"IsResting",
	"IsShiftKeyDown",
	"IsSpellKnown",
	"LibStub",
	"MAX_ACCOUNT_MACROS",
	"MacroFrame",
	"NUM_BAG_SLOTS",
	"PlaySound",
	"PlaySoundFile",
	"RAID_CLASS_COLORS",
	"SOUNDKIT",
	"SPELL_FAILED_TARGETS_DEAD",
	"SecureCmdOptionParse",
	"SetCVar",
	"Settings",
	"UIParent",
	"UISpecialFrames",
	"UnitAura",
	"UnitClass",
	"UnitExists",
	"UnitIsDead",
	"UnitIsFriend",
	"UnitIsGhost",
