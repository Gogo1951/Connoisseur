-- .luacheckrc
std = "lua51"
max_line_length = false -- StyLua owns formatting
ignore = { "611", "612", "613", "614", "621" } -- whitespace warnings — StyLua owns these too
self = false -- colon-defined handlers and widget stubs legitimately ignore self
exclude_files = {
	"Includes/", -- vendored, never linted
	"Features/Restocker/", -- vendored shape per References/Exceptions.md; converges in its own scheduled pass
}
read_globals = {
	-- WoW API surface Connoisseur calls
	"BuyMerchantItem",
	"C_AddOns",
	"C_Container",
	"C_EventUtils",
	"C_Item",
	"C_Map",
	"C_Timer",
	"CreateFrame",
	"CreateMacro",
